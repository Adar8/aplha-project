{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math5/lesson.schema.json",
  "title": "MATH 5 lesson",
  "description": "מבנה שיעור באפליקציית MATH 5. טקסטים בעברית עם LaTeX בתוך $...$ (או $$...$$ לשורה נפרדת). להדגשה: **טקסט**. בלי HTML.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "topic", "papers", "topicStatus", "estimatedMinutes", "summary", "review",
    "explanations", "formulas", "video", "examples", "guidedPractice", "independentPractice", "bagrutQuestions", "quiz", "commonMistakes", "next"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id", "description": "מזהה קבוע. ההתקדמות נשמרת לפיו, לכן לא משנים אותו אחרי פרסום." },
    "title": { "type": "string" },
    "topic": { "type": "string", "description": "מזהה נושא ממפת הנושאים, למשל sequences" },
    "papers": {
      "type": "object", "additionalProperties": false, "required": ["old", "new"],
      "properties": {
        "old": { "type": "array", "items": { "enum": ["035581", "035582"] } },
        "new": { "type": "array", "items": { "enum": ["035571", "035572"] } }
      }
    },
    "topicStatus": { "enum": ["common", "old", "new", "check"] },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string" },
    "review": {
      "type": "object", "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "reviewed", "approved"] },
        "mathCheckedBy": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "explanations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/explanation" } },
    "formulas": { "type": "array", "items": { "$ref": "#/$defs/formula" } },
    "video": {
      "type": "object", "required": ["status", "links"],
      "properties": {
        "status": { "enum": ["pending", "verified"] },
        "note": { "type": "string" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/example" } },
    "guidedPractice": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
    "independentPractice": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
    "bagrutQuestions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bagrutQuestion" } },
    "quiz": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/question" }, "description": "בלי רמזים" },
    "commonMistakes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mistake" } },
    "next": { "type": ["string", "null"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "explanation": {
      "type": "object", "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" },
        "blocks": { "type": "array", "minItems": 1, "items": { "oneOf": [
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "enum": ["text", "warning", "tip"] }, "text": { "type": "string" } } },
          { "type": "object", "required": ["type", "latex"], "properties": { "type": { "const": "formula" }, "latex": { "type": "string", "description": "LaTeX בלי $" }, "formulaRef": { "type": "string" } } },
          { "type": "object", "required": ["type", "items"], "properties": { "type": { "const": "list" }, "items": { "type": "array", "items": { "type": "string" } } } }
        ] } }
      }
    },
    "formula": {
      "type": "object", "required": ["id", "name", "latex", "inFormulaSheet"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "latex": { "type": "string" }, "inFormulaSheet": { "enum": ["yes", "no", "unknown"], "description": "האם הנוסחה מופיעה בדף הנוסחאות של הבחינה" } }
    },
    "link": {
      "type": "object", "required": ["label", "url", "kind", "verified"],
      "properties": { "label": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "kind": { "enum": ["video", "course", "search", "article"] }, "verified": { "type": "boolean" }, "teacher": { "type": "string" }, "minutes": { "type": "string" } }
    },
    "example": {
      "type": "object", "required": ["id", "title", "problem", "steps", "answer"],
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" }, "problem": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "answer": { "type": "string" },
        "checks": { "type": "array", "items": { "type": "object", "required": ["expr", "equals"], "properties": { "label": { "type": "string" }, "expr": { "$ref": "#/$defs/expr" }, "equals": { "type": "number" }, "tolerance": { "type": "number" } } } }
      }
    },
    "expr": { "type": "string", "description": "ביטוי חשבוני שהבודק מחשב: + - * / ^ ( ) ומהפונקציות sqrt abs floor ceil round exp ln log sin cos tan asin acos atan (במעלות), pi, e" },
    "source": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": { "enum": ["official", "adapted", "original"], "description": "רשמית / מעובדת / מקורית" },
        "exam": { "type": "string" }, "year": { "type": "integer" }, "session": { "type": "string" }, "questionNumber": { "type": "integer" }, "url": { "type": "string" },
        "basedOn": { "type": "object", "description": "בשאלה מעובדת: פרטי השאלה הרשמית (exam, year, session, questionNumber, url)" },
        "changes": { "type": "string", "description": "בשאלה מעובדת: מה שונה" }
      }
    },
    "question": {
      "type": "object", "required": ["id", "type", "prompt", "solution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["numeric", "multipleChoice"] },
        "label": { "type": "string", "description": "רק בסעיפים של שאלת בגרות: א, ב, ג…" },
        "difficulty": { "enum": [1, 2, 3] },
        "source": { "$ref": "#/$defs/source" },
        "prompt": { "type": "string" },
        "answer": {
          "type": "object", "required": ["value", "tolerance"],
          "properties": { "value": { "type": "number" }, "tolerance": { "type": "number", "minimum": 0 }, "rounding": { "type": "string", "description": "למשל: שתי ספרות אחרי הנקודה" } }
        },
        "check": { "$ref": "#/$defs/expr", "description": "חובה בשאלה מספרית: חישוב בלתי תלוי של התשובה" },
        "choices": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "correct": { "type": "boolean" }, "mistake": { "type": "string" } } }
        },
        "commonWrongAnswers": { "type": "array", "items": { "type": "object", "required": ["value", "mistake"], "properties": { "value": { "type": "number" }, "mistake": { "type": "string" } } } },
        "hints": { "type": "array", "items": { "type": "string" }, "description": "מדורגים: מהכללי לספציפי" },
        "solution": {
          "type": "object", "required": ["steps", "final"],
          "properties": { "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "final": { "type": "string" } }
        }
      }
    },
    "bagrutQuestion": {
      "type": "object", "required": ["id", "title", "source", "context", "parts"],
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" }, "difficulty": { "enum": [1, 2, 3] },
        "source": { "$ref": "#/$defs/source" }, "context": { "type": "string" },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "mistake": {
      "type": "object", "required": ["id", "label", "advice", "reviewSection"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "advice": { "type": "string" },
        "reviewSection": { "enum": ["explanations", "video", "examples", "guidedPractice", "independentPractice", "bagrutQuestions", "quiz"] },
        "reviewRef": { "type": "string", "description": "מזהה הסבר ספציפי לחזרה" }
      }
    }
  }
}
