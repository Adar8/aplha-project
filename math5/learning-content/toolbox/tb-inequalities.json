  "explanations": [
    {
      "id": "like-eq",
      "title": "כמו משוואה",
      "blocks": [
        {
          "type": "text",
          "text": "פותרים אי-שוויון בדיוק כמו משוואה: מעבירים אגפים ומחלקים. התשובה היא לא מספר אחד אלא **תחום**: $2x + 3 < 11 \\Rightarrow x < 4$."
        },
        {
          "type": "list",
          "items": [
            "$<$ קטן מ-, $>$ גדול מ-.",
            "$\\le$ קטן או שווה, $\\ge$ גדול או שווה."
          ]
        }
      ]
    },
    {
      "id": "flip",
      "title": "הכלל החשוב: מספר שלילי הופך את הסימן",
      "blocks": [
        {
          "type": "text",
          "text": "כשכופלים או מחלקים את שני האגפים במספר **שלילי**, הסימן מתהפך: $-3x \\ge 12 \\Rightarrow x \\le -4$."
        },
        {
          "type": "warning",
          "text": "למה? $2 < 5$, אבל אחרי כפל ב-$(-1)$: $-2 > -5$. הסדר מתהפך."
        }
      ]
    },
    {
      "id": "int",
      "title": "פתרונות שלמים",
      "blocks": [
        {
          "type": "text",
          "text": "אם $x < 4$, המספר השלם **הגדול** ביותר שמקיים הוא 3 (4 עצמו לא מקיים). אם $x \\le 4$ – זה 4."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "צעד רגיל",
      "problem": "פתרו: $2x + 3 < 11$",
      "steps": [
        "$2x < 8$.",
        "$x < 4$."
      ],
      "answer": "$x < 4$",
      "checks": [
        {
          "expr": "(11-3)/2",
          "equals": 4
        }
      ]
    },
    {
      "id": "ex2",
      "title": "חילוק במספר שלילי",
      "problem": "פתרו: $-3x \\ge 12$",
      "steps": [
        "מחלקים ב-$(-3)$ – והסימן מתהפך.",
        "$x \\le -4$."
      ],
      "answer": "$x \\le -4$",
      "checks": [
        {
          "expr": "12/(-3)",
          "equals": -4
        }
      ]
    },
    {
      "id": "ex3",
      "title": "משתנה עם מינוס",
      "problem": "פתרו: $5 - x > 2$",
      "steps": [
        "$-x > -3$.",
        "כופלים ב-$(-1)$ והופכים סימן: $x < 3$."
      ],
      "answer": "$x < 3$",
      "checks": [
        {
          "expr": "5-2",
          "equals": 3
        }
      ]
    }
  ],
