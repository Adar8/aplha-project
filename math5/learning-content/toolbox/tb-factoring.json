  "explanations": [
    {
      "id": "common",
      "title": "הוצאת גורם משותף",
      "blocks": [
        {
          "type": "text",
          "text": "פירוק הוא הכיוון ההפוך של פתיחת סוגריים: $6x + 9 = 3(2x + 3)$, ו-$x^2 - 3x = x(x - 3)$."
        },
        {
          "type": "tip",
          "text": "תמיד מתחילים בבדיקה: יש גורם משותף לכל האיברים?"
        }
      ]
    },
    {
      "id": "short",
      "title": "נוסחאות הכפל המקוצר",
      "blocks": [
        {
          "type": "formula",
          "latex": "(a + b)^2 = a^2 + 2ab + b^2"
        },
        {
          "type": "formula",
          "latex": "(a - b)^2 = a^2 - 2ab + b^2"
        },
        {
          "type": "formula",
          "latex": "(a - b)(a + b) = a^2 - b^2"
        },
        {
          "type": "warning",
          "text": "$(a + b)^2 \\ne a^2 + b^2$. האיבר האמצעי $2ab$ חובה."
        }
      ]
    },
    {
      "id": "trin",
      "title": "פירוק טרינום",
      "blocks": [
        {
          "type": "text",
          "text": "את $x^2 + bx + c$ מפרקים ל-$(x + p)(x + q)$ כש-$p\\cdot q = c$ ו-$p + q = b$."
        },
        {
          "type": "text",
          "text": "למשל $x^2 + 7x + 12$: מכפלה 12 וסכום 7 → 3 ו-4. לכן $(x + 3)(x + 4)$."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "ריבוע של סכום",
      "problem": "פתחו: $(x + 3)^2$",
      "steps": [
        "$a = x$, $b = 3$: $x^2 + 2\\cdot x\\cdot 3 + 3^2$.",
        "$x^2 + 6x + 9$."
      ],
      "answer": "$x^2 + 6x + 9$",
      "checks": [
        {
          "expr": "(2+3)^2",
          "equals": 25
        },
        {
          "expr": "2^2+6*2+9",
          "equals": 25
        }
      ]
    },
    {
      "id": "ex2",
      "title": "הפרש ריבועים",
      "problem": "פרקו: $x^2 - 25$",
      "steps": [
        "$25 = 5^2$ – זה הפרש ריבועים.",
        "$(x - 5)(x + 5)$."
      ],
      "answer": "$(x-5)(x+5)$",
      "checks": [
        {
          "expr": "3^2-25",
          "equals": -16
        },
        {
          "expr": "(3-5)*(3+5)",
          "equals": -16
        }
      ]
    },
    {
      "id": "ex3",
      "title": "טרינום",
      "problem": "פרקו: $x^2 + 7x + 12$",
      "steps": [
        "מחפשים מכפלה 12 וסכום 7: 3 ו-4.",
        "$(x + 3)(x + 4)$."
      ],
      "answer": "$(x+3)(x+4)$",
      "checks": [
        {
          "expr": "1^2+7*1+12",
          "equals": 20
        },
        {
          "expr": "(1+3)*(1+4)",
          "equals": 20
        }
      ]
    }
  ],
