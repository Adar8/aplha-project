  "explanations": [
    {
      "id": "what",
      "title": "מה זו חזקה?",
      "blocks": [
        {
          "type": "text",
          "text": "$2^5$ פירושו כפל של 2 בעצמו 5 פעמים: $2\\cdot2\\cdot2\\cdot2\\cdot2 = 32$. ה-2 הוא **הבסיס**, ה-5 הוא **המעריך**."
        },
        {
          "type": "warning",
          "text": "$3^4$ הוא 81, לא $3\\cdot 4 = 12$."
        }
      ]
    },
    {
      "id": "laws",
      "title": "חוקי החזקות (אותו בסיס)",
      "blocks": [
        {
          "type": "formula",
          "latex": "a^m\\cdot a^n = a^{m+n} \\qquad \\frac{a^m}{a^n} = a^{m-n} \\qquad \\left(a^m\\right)^n = a^{m\\cdot n}"
        },
        {
          "type": "formula",
          "latex": "a^0 = 1 \\qquad a^{-n} = \\frac{1}{a^n}"
        },
        {
          "type": "text",
          "text": "למשל: $2^3\\cdot 2^4 = 2^7 = 128$, ו-$5^{-2} = \\frac{1}{25}$."
        }
      ]
    },
    {
      "id": "root",
      "title": "שורש ריבועי",
      "blocks": [
        {
          "type": "text",
          "text": "$\\sqrt{a}$ הוא המספר האי-שלילי שבריבוע נותן $a$: $\\sqrt{49} = 7$. וגם $a^{\\frac12} = \\sqrt{a}$."
        },
        {
          "type": "formula",
          "latex": "\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot\\sqrt{b} \\qquad\\Rightarrow\\qquad \\sqrt{72} = \\sqrt{36}\\cdot\\sqrt{2} = 6\\sqrt{2}"
        },
        {
          "type": "warning",
          "text": "$\\sqrt{9+16} = \\sqrt{25} = 5$, ולא $\\sqrt9 + \\sqrt{16} = 7$. אין חוק כזה לחיבור."
        }
      ]
    }
  ],
  "examples": [
