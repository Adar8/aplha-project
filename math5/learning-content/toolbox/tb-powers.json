      "reviewSection": "explanations",
      "reviewRef": "laws"
    },
    {
      "id": "pow-power",
      "label": "חזקה של חזקה",
      "advice": "$(a^m)^n = a^{m\\cdot n}$: כופלים את המעריכים.",
      "reviewSection": "explanations",
      "reviewRef": "laws"
    },
    {
      "id": "zero-pow",
      "label": "חזקה 0 ושלילית",
      "advice": "$a^0 = 1$ (לא 0), ו-$a^{-n} = \\frac{1}{a^n}$.",
      "reviewSection": "explanations",
