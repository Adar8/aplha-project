  "commonMistakes": [
    {
      "id": "pow-mult",
      "label": "חזקה ככפל במעריך",
      "advice": "$a^n$ הוא כפל של $a$ בעצמו $n$ פעמים – לא $a$ כפול $n$.",
      "reviewSection": "explanations",
      "reviewRef": "what"
    },
    {
      "id": "pow-add",
      "label": "כפל וחילוק חזקות",
