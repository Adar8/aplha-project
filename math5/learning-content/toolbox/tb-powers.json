    {
      "id": "ex3",
      "title": "פירוק שורש",
      "problem": "פשטו: $\\sqrt{72}$",
      "steps": [
        "$72 = 36\\cdot 2$, ו-36 הוא ריבוע.",
        "$\\sqrt{72} = 6\\sqrt{2} \\approx 8.49$."
      ],
      "answer": "$6\\sqrt2$",
      "checks": [
        {
          "expr": "sqrt(72)",
          "equals": 8.485281374238571,
          "tolerance": 1e-09
        }
      ]
    }
  ],
