      "steps": [
        "מינוס ומינוס צמודים הופכים לפלוס: $6 - (-2) = 6 + 2$.",
        "$6 + 2 = 8$."
      ],
      "answer": "$8$",
      "checks": [
        {
          "expr": "6-(-2)",
          "equals": 8
        }
      ]
    },
    {
      "id": "ex3",
