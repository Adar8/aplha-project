  "explanations": [
    {
      "id": "rule",
      "title": "למה צריך סדר?",
      "blocks": [
        {
          "type": "text",
          "text": "כמה זה $2 + 3\\cdot 4$? אם מחשבים משמאל לימין יוצא 20, אבל התשובה הנכונה היא **14**. כדי שכולם יקבלו אותה תשובה, יש סדר קבוע:"
        },
        {
          "type": "list",
          "items": [
            "**סוגריים** – קודם מה שבתוכם.",
            "**חזקות ושורשים.**",
            "**כפל וחילוק** – משמאל לימין, לפי הסדר שבו הם מופיעים.",
            "**חיבור וחיסור** – משמאל לימין."
          ]
        }
      ]
    },
    {
      "id": "lr",
      "title": "כפל וחילוק באותה רמה",
      "blocks": [
        {
          "type": "text",
          "text": "כפל לא \"קודם\" לחילוק – הם באותה רמה, ומחשבים משמאל לימין: $12 : 3 \\cdot 2 = 4 \\cdot 2 = 8$."
        },
        {
          "type": "warning",
          "text": "$12 : 3 \\cdot 2$ הוא 8, לא 2. כדי לקבל 2 צריך סוגריים: $12 : (3 \\cdot 2)$."
        }
      ]
    },
    {
      "id": "bar",
      "title": "קו שבר הוא סוגריים",
      "blocks": [
        {
          "type": "text",
          "text": "בשבר, המונה והמכנה מחושבים כל אחד בנפרד, כאילו יש סביבם סוגריים: $\\frac{10+6}{5-1} = \\frac{16}{4} = 4$."
        },
        {
          "type": "tip",
          "text": "במחשבון מקלידים שבר כזה עם סוגריים: (10+6)/(5−1)."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "כפל לפני חיבור",
      "problem": "חשבו: $2 + 3\\cdot 4$",
      "steps": [
        "קודם הכפל: $3\\cdot 4 = 12$.",
        "אחר כך החיבור: $2 + 12 = 14$."
      ],
      "answer": "$14$",
      "checks": [
        {
          "expr": "2+3*4",
          "equals": 14
        }
      ]
    },
    {
      "id": "ex2",
      "title": "סוגריים וחזקה",
      "problem": "חשבו: $(8-2)\\cdot 3 - 4^2$",
      "steps": [
        "סוגריים: $8 - 2 = 6$.",
        "חזקה: $4^2 = 16$.",
        "כפל: $6\\cdot 3 = 18$.",
        "חיסור: $18 - 16 = 2$."
      ],
      "answer": "$2$",
      "checks": [
        {
          "expr": "(8-2)*3-4^2",
          "equals": 2
        }
      ]
    },
    {
      "id": "ex3",
      "title": "קו שבר",
      "problem": "חשבו: $\\frac{10+6}{5-1}$",
      "steps": [
        "מונה: $10 + 6 = 16$. מכנה: $5 - 1 = 4$.",
        "$16 : 4 = 4$."
      ],
      "answer": "$4$",
      "checks": [
        {
          "expr": "(10+6)/(5-1)",
          "equals": 4
        }
      ]
    }
  ],
