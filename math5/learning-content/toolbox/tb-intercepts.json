  "explanations": [
    {
      "id": "idea",
      "title": "גרף הוא כל הנקודות שמקיימות את המשוואה",
      "blocks": [
        {
          "type": "text",
          "text": "הגרף של $y = 2x - 6$ הוא אוסף כל הנקודות $(x, y)$ שמקיימות את המשוואה. לכן כדי לבדוק אם נקודה על הגרף – **מציבים** אותה ובודקים אם יוצא שוויון."
        },
        {
          "type": "text",
          "text": "למשל $(2, 1)$ על $y = 3x - 5$? $3\\cdot 2 - 5 = 1$ ✓ – כן."
        }
      ]
    },
    {
      "id": "axes",
      "title": "חיתוך עם הצירים",
      "blocks": [
        {
          "type": "list",
          "items": [
            "**חיתוך עם ציר ה-$y$**: מציבים $x = 0$.",
            "**חיתוך עם ציר ה-$x$**: מציבים $y = 0$ ופותרים משוואה."
          ]
        },
        {
          "type": "warning",
          "text": "הבלבול הנפוץ: על ציר ה-$x$ דווקא **$y$** שווה אפס, ועל ציר ה-$y$ דווקא **$x$** שווה אפס."
        },
        {
          "type": "tip",
          "text": "בישר $y = mx + b$, החיתוך עם ציר ה-$y$ הוא תמיד $(0, b)$ – אפשר לקרוא אותו מהמשוואה."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "שני החיתוכים של ישר",
      "problem": "מצאו את נקודות החיתוך של $y = 2x - 6$ עם הצירים.",
      "steps": [
        "ציר $y$: $x = 0 \\Rightarrow y = -6$. הנקודה $(0, -6)$.",
        "ציר $x$: $0 = 2x - 6 \\Rightarrow x = 3$. הנקודה $(3, 0)$."
      ],
      "answer": "$(0,-6)$ ו-$(3,0)$",
      "checks": [
        {
          "expr": "2*0-6",
          "equals": -6
        },
        {
          "expr": "6/2",
          "equals": 3
        }
      ]
    },
    {
      "id": "ex2",
      "title": "האם הנקודה על הגרף?",
      "problem": "האם הנקודה $(2, 1)$ נמצאת על הישר $y = 3x - 5$?",
      "steps": [
        "מציבים $x = 2$: $3\\cdot 2 - 5 = 1$.",
        "יצא $y = 1$ – בדיוק ה-$y$ של הנקודה. כן."
      ],
      "answer": "כן",
      "checks": [
        {
          "expr": "3*2-5",
          "equals": 1
        }
      ]
    },
    {
      "id": "ex3",
      "title": "גם לפרבולה",
      "problem": "מצאו את נקודות החיתוך של $y = x^2 - 4$ עם הצירים.",
      "steps": [
        "ציר $y$: $y = 0 - 4 = -4$.",
        "ציר $x$: $x^2 = 4 \\Rightarrow x = \\pm 2$.",
        "החיתוכים: $(0,-4)$, $(2,0)$, $(-2,0)$."
      ],
      "answer": "$(0,-4),\\ (\\pm2,0)$",
      "checks": [
        {
          "expr": "2^2-4",
          "equals": 0
        },
        {
          "expr": "(-2)^2-4",
          "equals": 0
        }
      ]
    }
  ],
