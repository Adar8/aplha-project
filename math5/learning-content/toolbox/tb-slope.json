  "explanations": [
    {
      "id": "what",
      "title": "שיפוע = כמה עולים על כל צעד ימינה",
      "blocks": [
        {
          "type": "text",
          "text": "דמיינו עלייה בכביש: השיפוע אומר בכמה עולים על כל מטר שמתקדמים. בגרף: **השינוי ב-$y$ חלקי השינוי ב-$x$**."
        },
        {
          "type": "formula",
          "latex": "m = \\frac{y_2 - y_1}{x_2 - x_1}"
        },
        {
          "type": "warning",
          "text": "למעלה – ההפרש ב-$y$, למטה – ההפרש ב-$x$. ושומרים על אותו סדר נקודות בשניהם."
        }
      ]
    },
    {
      "id": "sign",
      "title": "סימן השיפוע",
      "blocks": [
        {
          "type": "list",
          "items": [
            "$m > 0$: הישר **עולה** משמאל לימין.",
            "$m < 0$: הישר **יורד**.",
            "$m = 0$: ישר **אופקי**.",
            "ישר אנכי: השיפוע לא מוגדר (מחלקים באפס)."
          ]
        }
      ]
    },
    {
      "id": "eq",
      "title": "m ו-b במשוואת הישר",
      "blocks": [
        {
          "type": "formula",
          "latex": "y = mx + b"
        },
        {
          "type": "text",
          "text": "$m$ הוא השיפוע, ו-$b$ הוא נקודת החיתוך עם ציר ה-$y$: הנקודה $(0, b)$. למשל במחיר מונית $y = 8x + 12$: כל ק\"מ עולה 8 ₪ (השיפוע), ו-12 ₪ הם מחיר ההתחלה."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "שיפוע חיובי",
      "problem": "מהו השיפוע בין $(1, 2)$ ל-$(4, 8)$?",
      "steps": [
        "הפרש ב-$y$: $8 - 2 = 6$. הפרש ב-$x$: $4 - 1 = 3$.",
        "$m = \\frac{6}{3} = 2$. הישר עולה."
      ],
      "answer": "$m = 2$",
      "checks": [
        {
          "expr": "(8-2)/(4-1)",
          "equals": 2
        }
      ]
    },
    {
      "id": "ex2",
      "title": "שיפוע שלילי",
      "problem": "מהו השיפוע בין $(-2, 5)$ ל-$(2, -3)$?",
      "steps": [
        "$y$: $-3 - 5 = -8$. $x$: $2 - (-2) = 4$.",
        "$m = \\frac{-8}{4} = -2$. הישר יורד."
      ],
      "answer": "$m = -2$",
      "checks": [
        {
          "expr": "(-3-5)/(2-(-2))",
          "equals": -2
        }
      ]
    },
    {
      "id": "ex3",
      "title": "קריאה ממשוואה",
      "problem": "מה השיפוע ומה נקודת החיתוך עם ציר ה-$y$ של $y = 3x - 4$?",
      "steps": [
        "$m$ הוא המקדם של $x$: $m = 3$.",
        "$b = -4$, ולכן החיתוך עם ציר ה-$y$ הוא $(0, -4)$."
      ],
      "answer": "$m = 3$, $(0,-4)$",
      "checks": [
        {
          "expr": "3*0-4",
          "equals": -4
        }
      ]
    }
  ],
