  "explanations": [
    {
      "id": "what",
      "title": "משוואה ריבועית",
      "blocks": [
        {
          "type": "text",
          "text": "משוואה מהצורה $ax^2 + bx + c = 0$ (עם $a \\ne 0$). יכולים להיות לה **שני פתרונות, פתרון אחד, או אף אחד**."
        },
        {
          "type": "text",
          "text": "מקרה פשוט: $x^2 = 49$ – יש **שני** פתרונות: $x = 7$ וגם $x = -7$."
        },
        {
          "type": "warning",
          "text": "הטעות הכי נפוצה: לשכוח את הפתרון השלילי."
        }
      ]
    },
    {
      "id": "factor",
      "title": "פתרון בפירוק",
      "blocks": [
        {
          "type": "text",
          "text": "אם מכפלה שווה אפס, אחד הגורמים שווה אפס. למשל $x^2 - 5x + 6 = (x - 2)(x - 3) = 0$, ולכן $x = 2$ או $x = 3$."
        },
        {
          "type": "tip",
          "text": "כש-$a = 1$, מחפשים שני מספרים שמכפלתם $c$ וסכומם $b$. כאן: מכפלה 6, סכום $-5$ → $-2$ ו-$-3$."
        }
      ]
    },
    {
      "id": "formula",
      "title": "נוסחת השורשים",
      "blocks": [
        {
          "type": "formula",
          "latex": "x_{1,2} = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"
        },
        {
          "type": "text",
          "text": "הביטוי שבתוך השורש, $\\Delta = b^2 - 4ac$, נקרא **דיסקרימיננטה**: אם $\\Delta > 0$ יש שני פתרונות, אם $\\Delta = 0$ פתרון אחד, ואם $\\Delta < 0$ אין פתרון."
        },
        {
          "type": "warning",
          "text": "שימו לב ל-$-b$: אם $b = -4$, אז $-b = 4$."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "פירוק",
      "problem": "פתרו: $x^2 - 5x + 6 = 0$",
      "steps": [
        "מחפשים מכפלה 6 וסכום $-5$: $-2$ ו-$-3$.",
        "$(x - 2)(x - 3) = 0$.",
        "$x = 2$ או $x = 3$."
      ],
      "answer": "$x = 2,\\ 3$",
      "checks": [
        {
          "expr": "2^2-5*2+6",
          "equals": 0
        },
        {
          "expr": "3^2-5*3+6",
          "equals": 0
        }
      ]
    },
    {
      "id": "ex2",
      "title": "נוסחת השורשים",
      "problem": "פתרו: $2x^2 + 3x - 2 = 0$",
      "steps": [
        "$a = 2,\\ b = 3,\\ c = -2$.",
        "$\\Delta = 9 + 16 = 25$, ו-$\\sqrt{25} = 5$.",
        "$x = \\frac{-3 \\pm 5}{4}$: $x = 0.5$ או $x = -2$."
      ],
      "answer": "$x = 0.5,\\ -2$",
      "checks": [
        {
          "expr": "(-3+sqrt(3^2-4*2*(-2)))/(2*2)",
          "equals": 0.5
        },
        {
          "expr": "(-3-sqrt(3^2-4*2*(-2)))/(2*2)",
          "equals": -2
        }
      ]
    },
    {
      "id": "ex3",
      "title": "שני פתרונות",
      "problem": "פתרו: $x^2 = 49$",
      "steps": [
        "$x = \\sqrt{49}$ או $x = -\\sqrt{49}$.",
        "$x = 7$ או $x = -7$."
      ],
      "answer": "$x = \\pm 7$",
      "checks": [
        {
          "expr": "(-7)^2",
          "equals": 49
        }
      ]
    }
  ],
