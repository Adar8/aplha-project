  "explanations": [
    {
      "id": "what",
      "title": "המשפט",
      "blocks": [
        {
          "type": "text",
          "text": "במשולש ישר-זווית, הצלע שמול הזווית הישרה נקראת **יתר** – היא הארוכה ביותר. שתי הצלעות האחרות הן **ניצבים**."
        },
        {
          "type": "formula",
          "latex": "a^2 + b^2 = c^2 \\qquad (c \\text{ – היתר})"
        }
      ]
    },
    {
      "id": "leg",
      "title": "מציאת ניצב",
      "blocks": [
        {
          "type": "text",
          "text": "אם יודעים את היתר ואת אחד הניצבים, **מחסרים**: $b = \\sqrt{c^2 - a^2}$."
        },
        {
          "type": "warning",
          "text": "מחפשים ניצב – מחסרים. מחפשים יתר – מחברים. ואל תשכחו להוציא שורש בסוף."
        }
      ]
    },
    {
      "id": "converse",
      "title": "המשפט ההפוך",
      "blocks": [
        {
          "type": "text",
          "text": "אם בצלעות משולש מתקיים $a^2 + b^2 = c^2$ (כש-$c$ הארוכה), המשולש ישר-זווית. שלשות מוכרות: $3,4,5$ ו-$5,12,13$ (וכל כפולה שלהן)."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "מציאת יתר",
      "problem": "הניצבים במשולש ישר-זווית הם 6 ו-8. מהו היתר?",
      "steps": [
        "$c^2 = 6^2 + 8^2 = 36 + 64 = 100$.",
        "$c = \\sqrt{100} = 10$."
      ],
      "answer": "$10$",
      "checks": [
        {
          "expr": "sqrt(6^2+8^2)",
          "equals": 10
        }
      ]
    },
    {
      "id": "ex2",
      "title": "מציאת ניצב",
      "problem": "היתר 13 ואחד הניצבים 5. מהו הניצב השני?",
      "steps": [
        "$b^2 = 13^2 - 5^2 = 169 - 25 = 144$.",
        "$b = 12$."
      ],
      "answer": "$12$",
      "checks": [
        {
          "expr": "sqrt(13^2-5^2)",
          "equals": 12
        }
      ]
    },
    {
      "id": "ex3",
      "title": "אלכסון של מלבן",
      "problem": "מהו אורך האלכסון במלבן שמידותיו $9 \\times 12$?",
      "steps": [
        "האלכסון הוא יתר במשולש עם ניצבים 9 ו-12.",
        "$\\sqrt{81 + 144} = \\sqrt{225} = 15$."
      ],
      "answer": "$15$",
      "checks": [
        {
          "expr": "sqrt(9^2+12^2)",
          "equals": 15
        }
      ]
    }
  ],
