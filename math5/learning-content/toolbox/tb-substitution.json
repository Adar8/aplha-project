      "title": "הצבה של מספר שלילי",
      "problem": "חשב את $x^2 - 2x$ כאשר $x = -3$",
      "steps": [
        "מציבים עם סוגריים: $(-3)^2 - 2\\cdot(-3)$.",
        "$(-3)^2 = 9$, ו-$-2\\cdot(-3) = +6$.",
        "$9 + 6 = 15$."
      ],
      "answer": "$15$",
      "checks": [
        {
          "expr": "(-3)^2-2*(-3)",
          "equals": 15
        }
      ]
    },
    {
      "id": "ex3",
      "title": "מציאת x מתוך y",
      "problem": "נתון $y = 2x + 1$. מהו $x$ כאשר $y = 7$?",
      "steps": [
        "מציבים $y = 7$: $7 = 2x + 1$.",
        "$6 = 2x \\Rightarrow x = 3$."
      ],
      "answer": "$x = 3$",
      "checks": [
        {
          "expr": "(7-1)/2",
          "equals": 3
        }
      ]
    }
  ],
