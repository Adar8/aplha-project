  "explanations": [
    {
      "id": "dist",
      "title": "חוק הפילוג",
      "blocks": [
        {
          "type": "text",
          "text": "המספר שלפני הסוגריים כופל **כל** איבר בתוכם:"
        },
        {
          "type": "formula",
          "latex": "a(b + c) = ab + ac \\qquad 3(x + 4) = 3x + 12"
        },
        {
          "type": "warning",
          "text": "$3(x + 4)$ הוא $3x + 12$, לא $3x + 4$. צריך לכפול גם את ה-4."
        }
      ]
    },
    {
      "id": "minus",
      "title": "מינוס לפני סוגריים",
      "blocks": [
        {
          "type": "text",
          "text": "מינוס לפני סוגריים הופך את הסימן של **כל** איבר בפנים: $-(x - 7) = -x + 7$, ו-$-2(x - 5) = -2x + 10$."
        }
      ]
    },
    {
      "id": "like",
      "title": "איברים דומים",
      "blocks": [
        {
          "type": "text",
          "text": "איברים **דומים** הם איברים עם אותו משתנה באותה חזקה. מחברים רק את המקדמים: $3x + 5x = 8x$. מספרים בלי משתנה מחברים לחוד."
        },
        {
          "type": "text",
          "text": "$x$ לבד הוא $1x$: $7x - 2x + x = 6x$. ו-$x^2$ ו-$x$ **אינם** דומים."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "פילוג",
      "problem": "פתחו סוגריים: $3(x + 4)$",
      "steps": [
        "$3\\cdot x + 3\\cdot 4$.",
        "$3x + 12$. בדיקה עם $x = 2$: $3\\cdot 6 = 18$, ו-$6 + 12 = 18$ ✓"
      ],
      "answer": "$3x + 12$",
      "checks": [
        {
          "expr": "3*(2+4)",
          "equals": 18
        },
        {
          "expr": "3*2+12",
          "equals": 18
        }
      ]
    },
    {
      "id": "ex2",
      "title": "מינוס לפני סוגריים",
      "problem": "פתחו סוגריים: $-2(x - 5)$",
      "steps": [
        "$-2\\cdot x$ ו-$-2\\cdot(-5)$.",
        "$-2x + 10$."
      ],
      "answer": "$-2x + 10$",
      "checks": [
        {
          "expr": "-2*(1-5)",
          "equals": 8
        },
        {
          "expr": "-2*1+10",
          "equals": 8
        }
      ]
    },
    {
      "id": "ex3",
      "title": "כינוס",
      "problem": "פשטו: $4x + 3 - x + 7$",
      "steps": [
        "איברים עם $x$: $4x - x = 3x$.",
        "מספרים: $3 + 7 = 10$.",
        "$3x + 10$."
      ],
      "answer": "$3x + 10$",
      "checks": [
        {
          "expr": "4*2+3-2+7",
          "equals": 16
        },
        {
          "expr": "3*2+10",
          "equals": 16
        }
      ]
    }
  ],
