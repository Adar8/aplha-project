  "explanations": [
    {
      "id": "axes",
      "title": "שני צירים",
      "blocks": [
        {
          "type": "text",
          "text": "מערכת הצירים בנויה משני קווי מספרים: **ציר ה-$x$** אופקי (משמאל לימין) ו**ציר ה-$y$** אנכי (מלמטה למעלה). הם נפגשים ב**ראשית הצירים** $(0,0)$."
        },
        {
          "type": "tip",
          "text": "גם באפליקציה בעברית, הצירים נקראים כמו בכל ספר מתמטיקה: ציר x גדל משמאל לימין."
        }
      ]
    },
    {
      "id": "point",
      "title": "שיעורי נקודה",
      "blocks": [
        {
          "type": "text",
          "text": "כל נקודה מתוארת בשני מספרים בסוגריים: $(x, y)$. **קודם $x$ ואחר כך $y$** – קודם \"כמה ימינה או שמאלה\", ואחר כך \"כמה למעלה או למטה\"."
        },
        {
          "type": "formula",
          "latex": "(3,\\,-2):\\quad 3 \\text{ ימינה},\\; 2 \\text{ למטה}"
        },
        {
          "type": "list",
          "items": [
            "נקודה על ציר ה-$x$: ה-$y$ שלה הוא 0, למשל $(5, 0)$.",
            "נקודה על ציר ה-$y$: ה-$x$ שלה הוא 0, למשל $(0, -6)$."
          ]
        }
      ]
    },
    {
      "id": "quad",
      "title": "ארבעה רביעים",
      "blocks": [
        {
          "type": "list",
          "items": [
            "רביע ראשון: $x>0$ ו-$y>0$ (ימין למעלה).",
            "רביע שני: $x<0$ ו-$y>0$ (שמאל למעלה).",
            "רביע שלישי: $x<0$ ו-$y<0$ (שמאל למטה).",
            "רביע רביעי: $x>0$ ו-$y<0$ (ימין למטה)."
          ]
        }
      ]
    },
    {
      "id": "dist",
      "title": "מרחק על קו אופקי או אנכי",
      "blocks": [
        {
          "type": "text",
          "text": "אם לשתי נקודות אותו $y$, המרחק ביניהן הוא ההפרש בין ה-$x$-ים: בין $(-2, 3)$ ל-$(4, 3)$ המרחק הוא $4 - (-2) = 6$."
        },
        {
          "type": "warning",
          "text": "מרחק הוא תמיד חיובי. מחסרים את הקטן מהגדול – והזהרו ממינוס כפול."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "איפה הנקודה?",
      "problem": "תאר את מיקום הנקודה $(3, -2)$.",
      "steps": [
        "$x = 3$: שלוש יחידות ימינה מהראשית.",
        "$y = -2$: שתי יחידות למטה.",
        "$x$ חיובי ו-$y$ שלילי – רביע רביעי."
      ],
      "answer": "רביע רביעי",
      "checks": []
    },
    {
      "id": "ex2",
      "title": "נקודה על ציר",
      "problem": "הנקודה $(k - 2,\\, 5)$ נמצאת על ציר ה-$y$. מהו $k$?",
      "steps": [
        "על ציר ה-$y$ שיעור ה-$x$ הוא 0.",
        "$k - 2 = 0 \\Rightarrow k = 2$."
      ],
      "answer": "$k = 2$",
      "checks": [
        {
          "expr": "0+2",
          "equals": 2
        }
      ]
    },
    {
      "id": "ex3",
      "title": "מרחק בין נקודות",
      "problem": "מהו המרחק בין $(-2, 3)$ ל-$(4, 3)$?",
      "steps": [
        "לשתיהן $y = 3$ – הן על אותו קו אופקי.",
        "המרחק: $4 - (-2) = 6$."
      ],
      "answer": "$6$",
      "checks": [
        {
          "expr": "4-(-2)",
          "equals": 6
        }
      ]
    }
  ],
