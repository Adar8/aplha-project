  "explanations": [
    {
      "id": "what",
      "title": "מה זה פתרון של מערכת?",
      "blocks": [
        {
          "type": "text",
          "text": "מערכת היא שתי משוואות עם שני נעלמים, למשל $x + y = 10$ ו-$x - y = 4$. **הפתרון הוא זוג** $(x, y)$ שמקיים את **שתיהן**: כאן $x = 7,\\ y = 3$."
        },
        {
          "type": "warning",
          "text": "אל תעצרו אחרי שמצאתם משתנה אחד – צריך את שניהם."
        }
      ]
    },
    {
      "id": "add",
      "title": "שיטת החיבור",
      "blocks": [
        {
          "type": "text",
          "text": "אם לאחד הנעלמים יש מקדמים נגדיים, מחברים את המשוואות והוא נעלם:"
        },
        {
          "type": "formula",
          "latex": "(x + y) + (x - y) = 10 + 4 \\;\\Rightarrow\\; 2x = 14 \\;\\Rightarrow\\; x = 7"
        },
        {
          "type": "text",
          "text": "ואז מציבים בחזרה: $7 + y = 10 \\Rightarrow y = 3$. אם המקדמים שווים – **מחסרים**."
        }
      ]
    },
    {
      "id": "sub",
      "title": "שיטת ההצבה",
      "blocks": [
        {
          "type": "text",
          "text": "מבודדים נעלם מאחת המשוואות ומציבים בשנייה. אם $y = 2x$ ו-$x + y = 9$: $x + 2x = 9 \\Rightarrow x = 3$, ואז $y = 6$."
        },
        {
          "type": "tip",
          "text": "בסוף בודקים: מציבים את שני המספרים בשתי המשוואות."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "חיבור",
      "problem": "פתרו: $x + y = 10$, $x - y = 4$",
      "steps": [
        "מחברים: $2x = 14 \\Rightarrow x = 7$.",
        "מציבים: $7 + y = 10 \\Rightarrow y = 3$.",
        "בדיקה: $7 - 3 = 4$ ✓"
      ],
      "answer": "$x = 7,\\ y = 3$",
      "checks": [
        {
          "expr": "(10+4)/2",
          "equals": 7
        },
        {
          "expr": "10-7",
          "equals": 3
        }
      ]
    },
    {
      "id": "ex2",
      "title": "הצבה",
      "problem": "פתרו: $y = 2x$, $x + y = 9$",
      "steps": [
        "מציבים $y = 2x$ בשנייה: $3x = 9 \\Rightarrow x = 3$.",
        "$y = 2\\cdot 3 = 6$."
      ],
      "answer": "$x = 3,\\ y = 6$",
      "checks": [
        {
          "expr": "9/3",
          "equals": 3
        },
        {
          "expr": "2*3",
          "equals": 6
        }
      ]
    },
    {
      "id": "ex3",
      "title": "בידוד והצבה",
      "problem": "פתרו: $2x + 3y = 12$, $x - y = 1$",
      "steps": [
        "מהשנייה: $x = 1 + y$.",
        "מציבים: $2(1 + y) + 3y = 12 \\Rightarrow 5y = 10 \\Rightarrow y = 2$.",
        "$x = 1 + 2 = 3$."
      ],
      "answer": "$x = 3,\\ y = 2$",
      "checks": [
        {
          "expr": "(12-2)/5",
          "equals": 2
        },
        {
          "expr": "2*3+3*2",
          "equals": 12
        }
      ]
    }
  ],
