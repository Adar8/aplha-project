  "explanations": [
    {
      "id": "balance",
      "title": "משוואה היא מאזניים",
      "blocks": [
        {
          "type": "text",
          "text": "משוואה כמו $2x + 5 = 13$ היא מאזניים בשיווי משקל. מותר לעשות כל פעולה – **בתנאי שעושים אותה בשני האגפים**. המטרה: להשאיר את $x$ לבד בצד אחד."
        },
        {
          "type": "formula",
          "latex": "2x + 5 = 13 \\;\\Rightarrow\\; 2x = 8 \\;\\Rightarrow\\; x = 4"
        }
      ]
    },
    {
      "id": "steps",
      "title": "סדר הפעולות בפתרון",
      "blocks": [
        {
          "type": "list",
          "items": [
            "פותחים סוגריים (אם יש).",
            "מעבירים את כל האיברים עם $x$ לאגף אחד, ואת המספרים לאגף השני.",
            "מכנסים: מחברים איברים דומים.",
            "מחלקים במקדם של $x$."
          ]
        },
        {
          "type": "warning",
          "text": "כשמעבירים איבר לאגף השני, **הסימן שלו מתהפך**: $x + 7 = 12 \\Rightarrow x = 12 - 7$."
        }
      ]
    },
    {
      "id": "check",
      "title": "בודקים את התשובה",
      "blocks": [
        {
          "type": "text",
          "text": "תמיד אפשר לבדוק: מציבים את הפתרון במשוואה המקורית. אם $x = 4$, אז $2\\cdot 4 + 5 = 13$ – נכון."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "ex1",
      "title": "שני צעדים",
      "problem": "פתור: $2x + 5 = 13$",
      "steps": [
        "מעבירים את 5 לאגף ימין (והסימן מתהפך): $2x = 13 - 5 = 8$.",
        "מחלקים ב-2: $x = 4$.",
        "בדיקה: $2\\cdot 4 + 5 = 13$ ✓"
      ],
      "answer": "$x = 4$",
      "checks": [
        {
          "expr": "(13-5)/2",
          "equals": 4
        }
      ]
    },
    {
      "id": "ex2",
      "title": "עם סוגריים, x בשני האגפים",
      "problem": "פתור: $3(x - 2) = x + 8$",
      "steps": [
        "פותחים סוגריים: $3x - 6 = x + 8$.",
        "מעבירים את $x$ שמאלה ואת $-6$ ימינה: $3x - x = 8 + 6$.",
        "$2x = 14 \\Rightarrow x = 7$.",
        "בדיקה: $3(7-2) = 15$, ו-$7 + 8 = 15$ ✓"
      ],
      "answer": "$x = 7$",
      "checks": [
        {
          "expr": "(8+6)/(3-1)",
          "equals": 7
        }
      ]
    },
    {
      "id": "ex3",
      "title": "מקדם שלילי",
      "problem": "פתור: $5 - 2x = 11$",
      "steps": [
        "מעבירים את 5: $-2x = 11 - 5 = 6$.",
        "מחלקים ב-$(-2)$: $x = -3$."
      ],
      "answer": "$x = -3$",
      "checks": [
        {
          "expr": "(11-5)/(-2)",
          "equals": -3
        }
      ]
    }
  ],
