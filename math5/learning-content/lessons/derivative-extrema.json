  "examples": [
    {
      "id": "ex1",
      "title": "חקירה מלאה של פולינום ממעלה 3",
      "problem": "מצא את נקודות הקיצון ואת תחומי העלייה והירידה של $f(x) = x^3 - 3x^2 - 9x + 5$.",
      "steps": [
        "גוזרים: $f'(x) = 3x^2 - 6x - 9$.",
        "משווים לאפס: $3x^2 - 6x - 9 = 0 \\Rightarrow x^2 - 2x - 3 = 0 \\Rightarrow (x-3)(x+1) = 0$.",
        "נקודות חשודות: $x=-1$ ו-$x=3$.",
        "טבלת סימנים: ב-$x=-2$: $f'(-2) = 12+12-9 = 15 > 0$. ב-$x=0$: $f'(0) = -9 0$.",
        "ב-$x=-1$ הנגזרת עוברת מ-$+$ ל-$-$: מקסימום. $f(-1) = -1 - 3 + 9 + 5 = 10$.",
        "ב-$x=3$ הנגזרת עוברת מ-$-$ ל-$+$: מינימום. $f(3) = 27 - 27 - 27 + 5 = -22$."
      ],
      "answer": "מקסימום $(-1, 10)$, מינימום $(3, -22)$. עולה כאשר $x3$, יורדת כאשר $-1<x<3$.",
      "checks": [
        {
          "label": "f(-1)",
          "expr": "(-1)^3-3*(-1)^2-9*(-1)+5",
          "equals": 10
        },
        {
          "label": "f(3)",
          "expr": "27-27-27+5",
          "equals": -22
        }
      ]
    },
    {
      "id": "ex2",
      "title": "משוואת משיק",
      "problem": "מצא את משוואת המשיק לגרף $f(x) = x^2 - 4x + 1$ בנקודה שבה $x = 3$.",
      "steps": [
        "גובה הנקודה: $f(3) = 9 - 12 + 1 = -2$. הנקודה היא $(3, -2)$.",
        "שיפוע: $f'(x) = 2x - 4$, ולכן $m = f'(3) = 2$.",
        "$y - (-2) = 2(x - 3) \\Rightarrow y = 2x - 8$.",
        "בדיקה: $2\\cdot 3 - 8 = -2$. ✓"
      ],
      "answer": "$y = 2x - 8$",
      "checks": [
        {
          "label": "f(3)",
          "expr": "9-12+1",
          "equals": -2
        },
        {
          "label": "f'(3)",
          "expr": "2*3-4",
          "equals": 2
        }
      ]
    },
    {
      "id": "ex3",
      "title": "פרמטר",
      "problem": "לפונקציה $f(x) = x^3 + ax^2 + 3$ יש נקודת קיצון ב-$x = 2$. מצא את $a$ וקבע את סוג הנקודה.",
      "steps": [
        "$f'(x) = 3x^2 + 2ax$. בנקודת קיצון $f'(2) = 0$.",
        "$12 + 4a = 0 \\Rightarrow a = -3$.",
        "עכשיו $f'(x) = 3x^2 - 6x = 3x(x-2)$. ב-$x=1$: $f'(1) = -3 0$.",
        "הסימן עובר מ-$-$ ל-$+$: מינימום. $f(2) = 8 - 12 + 3 = -1$."
      ],
      "answer": "$a=-3$, ו-$(2,-1)$ היא נקודת מינימום.",
      "checks": [
        {
          "label": "a",
          "expr": "-12/4",
          "equals": -3
        },
        {
          "label": "f(2)",
          "expr": "8-12+3",
          "equals": -1
        }
      ]
    }
  ],
