  "examples": [
    {
      "id": "ex1",
      "title": "איבר וסכום",
      "problem": "בסדרה חשבונית $a_1=5$ ו-$d=3$. מצא את $a_{20}$ ואת $S_{20}$.",
      "steps": [
        "האיבר הכללי: $a_{20} = a_1 + 19d$.",
        "$a_{20} = 5 + 19\\cdot 3 = 5 + 57 = 62$.",
        "עכשיו יודעים את האיבר האחרון, לכן נוח להשתמש ב-$S_n = \\frac{n(a_1+a_n)}{2}$.",
        "$S_{20} = \\frac{20\\,(5+62)}{2} = 10\\cdot 67 = 670$."
      ],
      "answer": "$a_{20}=62,\\ S_{20}=670$",
      "checks": [
        {
          "label": "a20",
          "expr": "5 + 19*3",
          "equals": 62
        },
        {
          "label": "S20",
          "expr": "20*(5+62)/2",
          "equals": 670
        }
      ]
    },
    {
      "id": "ex2",
      "title": "סדרה משני נתונים",
      "problem": "בסדרה חשבונית $a_4=11$ ו-$a_9=26$. מצא את $a_1$, את $d$, ואת מקומו של האיבר $95$.",
      "steps": [
        "בין $a_4$ ל-$a_9$ יש 5 קפיצות: $a_9 - a_4 = 5d$.",
        "$26-11 = 15 = 5d \\Rightarrow d = 3$.",
        "$a_4 = a_1 + 3d \\Rightarrow 11 = a_1 + 9 \\Rightarrow a_1 = 2$.",
        "האיבר הכללי: $a_n = 2 + (n-1)\\cdot 3 = 3n-1$.",
        "$3n - 1 = 95 \\Rightarrow 3n = 96 \\Rightarrow n = 32$. מספר שלם וחיובי, לכן 95 הוא אכן איבר בסדרה."
      ],
      "answer": "$a_1=2,\\ d=3$, ו-95 הוא האיבר ה-32.",
      "checks": [
        {
          "label": "d",
          "expr": "(26-11)/5",
          "equals": 3
        },
        {
          "label": "a1",
          "expr": "11-3*3",
          "equals": 2
        },
        {
          "label": "n",
          "expr": "(95+1)/3",
          "equals": 32
        }
      ]
    },
    {
      "id": "ex3",
      "title": "כמה איברים צריך?",
      "problem": "בסדרה $2, 5, 8, \\dots$ כמה איברים ראשונים צריך לחבר כדי לקבל סכום $610$?",
      "steps": [
        "$a_1=2,\\ d=3$. לא יודעים את האיבר האחרון, לכן משתמשים ב-$S_n=\\frac{n(2a_1+(n-1)d)}{2}$.",
        "$\\frac{n\\,(4 + 3(n-1))}{2} = \\frac{n(3n+1)}{2} = 610$.",
        "$3n^2 + n - 1220 = 0$.",
        "$n = \\frac{-1 \\pm \\sqrt{1 + 14640}}{6} = \\frac{-1 \\pm 121}{6}$.",
        "$n = 20$ (הפתרון השלילי נפסל, כי $n$ הוא מספר איברים)."
      ],
      "answer": "20 איברים.",
      "checks": [
        {
          "label": "n",
          "expr": "(-1+sqrt(1+4*3*1220))/6",
          "equals": 20
        },
        {
          "label": "S20",
          "expr": "20*(2*2+19*3)/2",
          "equals": 610
        }
      ]
    }
  ],
