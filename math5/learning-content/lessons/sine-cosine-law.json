  "examples": [
    {
      "id": "ex1",
      "title": "שתי צלעות והזווית שביניהן",
      "problem": "במשולש $b = 8$, $c = 5$ והזווית ביניהן $\\alpha = 60^\\circ$. מצא את $a$.",
      "steps": [
        "יודעים שתי צלעות והזווית שביניהן: משפט הקוסינוסים.",
        "$a^2 = b^2 + c^2 - 2bc\\cos\\alpha = 64 + 25 - 2\\cdot 8\\cdot 5\\cdot\\cos 60^\\circ$.",
        "$\\cos 60^\\circ = \\tfrac12$, ולכן $a^2 = 89 - 40 = 49$.",
        "$a = 7$."
      ],
      "answer": "$a = 7$",
      "checks": [
        {
          "label": "a",
          "expr": "sqrt(64+25-2*8*5*cos(60))",
          "equals": 7
        }
      ]
    },
    {
      "id": "ex2",
      "title": "צלע ושתי זוויות",
      "problem": "במשולש $a = 10$, $\\alpha = 30^\\circ$, $\\beta = 45^\\circ$. מצא את $b$ ואת רדיוס המעגל החוסם.",
      "steps": [
        "יש זוג צלע-זווית ($a$, $\\alpha$): משפט הסינוסים.",
        "$\\frac{b}{\\sin 45^\\circ} = \\frac{10}{\\sin 30^\\circ} \\Rightarrow b = \\frac{10\\cdot\\sin45^\\circ}{\\sin30^\\circ} = \\frac{10\\cdot 0.7071}{0.5}$.",
        "$b \\approx 14.14$ (בדיוק: $10\\sqrt2$).",
        "$2R = \\frac{a}{\\sin\\alpha} = \\frac{10}{0.5} = 20 \\Rightarrow R = 10$."
      ],
      "answer": "$b = 10\\sqrt2 \\approx 14.14$, $R = 10$",
      "checks": [
        {
          "label": "b",
          "expr": "10*sin(45)/sin(30)",
          "equals": 14.142,
          "tolerance": 0.001
        },
        {
          "label": "R",
          "expr": "10/(2*sin(30))",
          "equals": 10
        }
      ]
    },
    {
      "id": "ex3",
      "title": "שלוש צלעות",
      "problem": "במשולש הצלעות 5, 7 ו-8. מצא את הזווית שמול הצלע 7 ואת שטח המשולש.",
      "steps": [
        "יודעים שלוש צלעות: משפט הקוסינוסים, ומבודדים את הקוסינוס.",
        "$7^2 = 5^2 + 8^2 - 2\\cdot 5\\cdot 8\\cos\\gamma \\Rightarrow 49 = 89 - 80\\cos\\gamma$.",
        "$\\cos\\gamma = \\frac{40}{80} = \\frac12 \\Rightarrow \\gamma = 60^\\circ$.",
        "השטח, עם שתי הצלעות שסביב הזווית: $S = \\tfrac12\\cdot5\\cdot8\\cdot\\sin60^\\circ = 20\\cdot\\frac{\\sqrt3}{2} = 10\\sqrt3 \\approx 17.32$."
      ],
      "answer": "$\\gamma = 60^\\circ$, $S = 10\\sqrt3 \\approx 17.32$",
      "checks": [
        {
          "label": "gamma",
          "expr": "acos((25+64-49)/(2*5*8))",
          "equals": 60
        },
        {
          "label": "S",
          "expr": "0.5*5*8*sin(60)",
          "equals": 17.3205,
          "tolerance": 0.0001
        }
      ]
    }
  ],
